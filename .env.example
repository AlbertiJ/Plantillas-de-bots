# ══════════════════════════════════════════════════════════════════
# .env.example — Plantillas de Bots (Telegram & WhatsApp)
# ══════════════════════════════════════════════════════════════════
# Copiá este archivo como .env:
#   cp .env.example .env
# Luego completá los valores con tus credenciales reales y guardá.
# El archivo .env NO se sube a Git (está en .gitignore).
# ══════════════════════════════════════════════════════════════════

# ── PANEL ADMIN ────────────────────────────────────────────────────
# Clave secreta para las sesiones del panel de administración.
# Cambiala por una cadena aleatoria larga (mínimo 32 caracteres).
SESSION_SECRET=CAMBIAR_por_una_clave_secreta_larga

# ── TELEGRAM ───────────────────────────────────────────────────────
# Token del bot Telegram. Obtenélo en @BotFather:
#   1. Abrí Telegram y buscá @BotFather
#   2. Enviá /newbot y seguí los pasos
#   3. Copiá el token que te da (formato: 123456789:ABC-DEF...)
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI

# ID de Telegram del propietario (para comandos de admin en grupos).
# Para obtenerlo, enviá cualquier mensaje a @userinfobot.
TELEGRAM_OWNER_ID=0

# ID del canal de logs (opcional). Ponelo en 0 para desactivar.
LOG_CHANNEL_ID=0

# ── WHATSAPP (Twilio) ──────────────────────────────────────────────
# Credenciales de Twilio para los bots de WhatsApp.
# Registrate en https://www.twilio.com/try-twilio (cuenta gratuita disponible).
# Encontrás estos datos en: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
TWILIO_PHONE=whatsapp:+14155238886

# ── INTELIGENCIA ARTIFICIAL (opcional) ────────────────────────────
# Solo necesarios para los bots con agentes IA.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ── BASE DE DATOS ──────────────────────────────────────────────────
# Ruta del archivo SQLite local (se crea automáticamente).
DB_PATH=data/bot.db

# ── PANEL — CONFIGURACIÓN AVANZADA ────────────────────────────────
# Puerto del servidor API (default: 3001). Normalmente no es necesario cambiar.
# PORT=3001

# URL base de la API que usa el frontend (solo si corrés en un servidor remoto).
# VITE_API_URL=http://localhost:3001
