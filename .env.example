# ============================================
# Plantillas-de-bots — configuración base
# ============================================
# MODIFICAR: token del bot principal (commit 10 lo vuelve un pool de perfiles)
TELEGRAM_BOT_TOKEN=

# MODIFICAR: claves de APIs externas según los bots que vayas a activar
SHERLOCK_API_KEY=
SUBFINDER_API_KEY=
NUCLEI_API_KEY=

# MODIFICAR: secret de la app (se genera uno aleatorio en el primer arranque si está vacío)
SECRET_KEY=

# MODIFICAR: ruta absoluta de la base de datos de bots del builder
DATA_DIR=./data

# MODIFICAR: puerto del servidor
PORT=8000

# MODIFICAR: entorno (development | production)
ENV=development
